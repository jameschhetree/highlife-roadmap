// HighLife Roadmap — schema derived from the Operating System 2026-2027 document.
//
// Section 17 of that document specifies exactly what a Roadmap item must carry,
// and this model is that list rather than a reinterpretation of it. The previous
// Phase/Task/Step model described a different plan entirely (Foundation, Revenue
// Growth, Brand Expansion, Scale) and could not represent quarterly OKRs, pillars
// or KPI impact at all.
//
// The document's own boundary rule applies here: the Roadmap tracks the company,
// HighLevel tracks customers. There is deliberately no lead, contact or deal
// model — adding one would turn this into the second CRM the plan warns against.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// The three company objectives per quarter. Section 13: no more than three.
enum ObjectiveKind {
  RevenueEngine    // O1 — how are we growing durable revenue?
  OperatingSystem  // O2 — can the team deliver the growth reliably?
  BrandFootprint   // O3 — are Music, Media and Merch getting stronger?
}

enum Pillar {
  Revenue
  Podcast
  Music
  Media
  Merch
  Events
  Operations
  Finance
}

enum Priority {
  Critical
  Standard
  Backlog
}

enum Status {
  NotStarted
  InProgress
  Blocked
  Done
}

// The eight views from section 17. An item declares which one it belongs to so
// the views are a property of the data, not a guess made at render time.
enum View {
  ThisWeek
  QuarterlyOKR
  RevenueProject
  ContentCalendar
  Event
  SOP
  DecisionLog
}

/// A planning period: the Launch Sprint plus five quarters through Q4 2027.
model Quarter {
  id            String  @id @default(cuid())
  key           String  @unique // "launch-sprint", "q4-2026", ...
  name          String
  dates         String
  revenueTarget String // e.g. "$16K"
  cumulative    String // e.g. "$16K"
  focus         String // the primary revenue objective for the period
  sortOrder     Int
  isCurrent     Boolean @default(false)

  objectives Objective[]
  items      Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One of the three objectives inside a quarter, with its key results.
model Objective {
  id        String        @id @default(cuid())
  quarterId String
  quarter   Quarter       @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  kind      ObjectiveKind
  title     String
  sortOrder Int           @default(0)

  keyResults KeyResult[]
  items      Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A measurable key result. Scored 0.0-1.0 at quarter end (section 13).
model KeyResult {
  id          String    @id @default(cuid())
  objectiveId String
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  label       String // "KR1"
  text        String
  score       Float? // null until the quarter is scored
  sortOrder   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Everything that gets worked on. One row per commitment, project, SOP,
/// content slot, event or decision.
model Item {
  id     String @id @default(cuid())
  title  String
  /// Section 09: "If a task has no owner, it is not a task; it is an idea."
  /// Enforced at the API boundary, not merely encouraged — hence no default.
  owner  String
  pillar Pillar @default(Operations)
  view   View   @default(ThisWeek)

  quarterId String?
  quarter   Quarter? @relation(fields: [quarterId], references: [id], onDelete: SetNull)

  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  priority Priority @default(Standard)
  status   Status   @default(NotStarted)
  dueDate  DateTime?
  /// A real date is required for a weekly commitment; other views may run
  /// without one, so the column stays nullable and the rule lives in the API.
  kpi      String   @default("")
  notes    String   @default("")

  /// Free text rather than a self-relation: the document asks "what must happen
  /// first or who is blocking it", which is often a person or an outside event,
  /// not another row in this table.
  dependency String @default("")

  /// Which of the twelve execution weeks this came from, if it was loaded from
  /// the plan rather than typed. Lets the app tell "already pulled in" from
  /// "not started", so loading a week twice cannot duplicate it.
  weekNumber Int?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([view, status])
  @@index([weekNumber])
  @@index([quarterId])
}

/// Section 20's twelve-week plan. Kept separate from Item because a week is a
/// fixed schedule with one deliverable, not a commitment anyone owns.
model ExecutionWeek {
  id          String  @id @default(cuid())
  week        Int     @unique
  objective   String
  deliverable String
  done        Boolean @default(false)
  /// Monday of this week, derived from the sprint start (Aug 10, 2026), so the
  /// app can say which week it is now rather than making James count.
  startsOn    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The four meetings from sections 10 and 12, each with its own job.
enum MeetingKind {
  MondayBusiness  // 10:00 AM, 60-75 min — scoreboard, funnel, ops, people, money, roadmap, commit
  MondayMonthly   // first Monday, 90 min — replaces the weekly, does not add a meeting
  WednesdayTeam   // 5:30 PM, 45-60 min — wins, bookings, training, accountability
  SundayBrand     // 4:00 PM, 45-60 min — rank Music/Media/Merch, creative decisions
}

/// One occurrence of a meeting, with the numbers that were true that week.
///
/// Section 15's scoreboard lives here rather than in its own table because the
/// plan never asks for numbers in the abstract — it asks what was on the board
/// at the Monday meeting. Keeping them together means a week with no meeting is
/// visibly a week with no scoreboard, which is the thing worth noticing.
model Meeting {
  id   String      @id @default(cuid())
  kind MeetingKind
  date DateTime
  held Boolean     @default(false)

  // Monday scorecard (section 22). Null means not filled in, not zero.
  cashCollected      Float?
  podcastRevenue     Float?
  podcastMrr         Float?
  musicRevenue       Float?
  leads              Int?
  toursBooked        Int?
  toursShowed        Int?
  tourCloseRate      Float?
  recurringConversion Float?
  roomHours          Float?
  editTurnaround     Float?
  roadmapCompletion  Float?

  /// Wednesday and Sunday do not get a scoreboard — the numbers belong to
  /// Monday. What they need is a prep brief written before the meeting, so the
  /// room starts on decisions rather than on catching up.
  prep      String @default("")
  decisions String @default("") // decisions and blockers raised
  notes     String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, date])
  @@index([date])
}

/// The plan itself, section by section, editable in the app.
///
/// Jaco asked for the document to live on the site as something he can navigate
/// and change, rather than a PDF that goes stale in a chat thread. Storing it as
/// sections beats modelling all 23 of them as bespoke features: the parts the
/// app acts on (OKRs, SOPs, the scoreboard) are real tables, and the parts it
/// only needs to state — the North Star, the guardrails, the ICP — are text he
/// can edit when the strategy moves.
model PlanSection {
  id      String @id @default(cuid())
  number  Int    @unique
  title   String
  body    String
  pages   String @default("")
  /// The rendered pages, so the plan can be read as it was designed — charts,
  /// tables and all. PDF text extraction loses the layout that carries half the
  /// meaning in this document; the text below the image stays for search and
  /// editing.
  pageImages String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The 17-month revenue path from section 03. Separate from Quarter because the
/// plan tracks and reviews money monthly, not quarterly.
model MonthTarget {
  id         String @id @default(cuid())
  key        String @unique // "2026-08"
  label      String
  target     Int    // dollars
  cumulative Int
  collected  Int?   // what actually came in
  sortOrder  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Section 15's Monday thresholds. Stored rather than hardcoded because the plan
/// says to recalibrate them after 60-90 days of real data.
model Threshold {
  id        String @id @default(cuid())
  metric    String @unique
  green     String
  yellow    String
  red       String
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Section 20: what should be true after 90 days.
model NinetyDayTest {
  id        String  @id @default(cuid())
  text      String
  passed    Boolean @default(false)
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TriggerKind {
  Capacity // section 08 — when to add hours, pricing, editors or a second room
  Hiring   // section 16 — when a role becomes worth paying for
}

/// A condition that, once true, obliges a decision.
///
/// The plan states these as prose and prose gets forgotten. Held as rows they
/// can be reviewed on a Monday and marked as firing, which is the difference
/// between a trigger and a paragraph.
model Trigger {
  id        String      @id @default(cuid())
  kind      TriggerKind
  signal    String
  condition String
  action    String
  /// Set when the condition is judged met. The plan's discipline is that the
  /// action follows the trigger, not the mood of the room.
  firing    Boolean     @default(false)
  notes     String      @default("")
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The recurring package architecture from section 05.
///
/// Prices are marked provisional until the cost study exists: the plan says not
/// to finalise them before real editor hours, production labour, revisions,
/// commission and payment fees are measured.
model Offer {
  id          String  @id @default(cuid())
  name        String
  price       String
  designedFor String
  scope       String
  isPackage   Boolean @default(true) // false for the à la carte service stack
  costStudied Boolean @default(false)
  sortOrder   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Section 19's risk register, with the mitigation the plan already chose.
model Risk {
  id         String  @id @default(cuid())
  risk       String
  showsUpAs  String
  mitigation String
  /// Whether the mitigation is actually in place, as opposed to written down.
  mitigated  Boolean @default(false)
  owner      String  @default("Unassigned")
  sortOrder  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// An inferred answer to "what should this week be about", kept so it is not
/// recomputed on every page load.
///
/// The deterministic checks (unowned, blocked, overdue) are hygiene: useful, but
/// Jaco correctly said they are not the plan. This holds a reading of the plan
/// against the current state — which quarter objective this week serves, what the
/// execution week asks for, who now owns what. It is regenerated when he asks or
/// when the state it was based on has moved.
model WeeklyFocus {
  id        String   @id @default(cuid())
  /// Fingerprint of the state it was generated from, so a stale one is visible.
  basis     String
  body      String   // JSON array of { text, why, owner, section }
  createdAt DateTime @default(now())
}

model ChatLog {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())
}
